<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Reactor (parent) POM.

    Why inherit from spring-boot-starter-parent instead of importing spring-boot-dependencies?
      * starter-parent gives you dependencyManagement AND sane pluginManagement
        (compiler release, surefire, resource filtering, the repackage goal).
      * If you already have a corporate parent POM you cannot replace, import
        spring-boot-dependencies as a BOM (type=pom, scope=import) and wire plugins yourself.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>springboot-learn</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>springboot-learn (reactor)</name>
  <description>A guided, senior-level tour of Spring Boot: customization, JPA, transactions, resilient HTTP.</description>

  <modules>
    <module>platform-starter</module>
    <module>order-service</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      Spring Cloud release trains are pinned to a Boot minor: 2025.0.x targets Boot 3.5.x,
      2025.1.x targets the next one. Mixing lines is the most common cause of NoSuchMethodError
      or NoClassDefFoundError at startup in a Spring Cloud application.

      Note also what this BOM OWNS. It manages resilience4j (for spring-cloud-circuitbreaker), so
      it silently overrides any version you pinned yourself. This project originally pinned
      resilience4j 2.3.0; importing this BOM left resilience4j-spring-boot3 at 2.3.0 and every
      other resilience4j module at the BOM's 2.2.0, and the application then failed to start with

          NoClassDefFoundError: io/github/resilience4j/spring6/fallback/RxJava3FallbackDecorator

      because the 2.3.0 autoconfiguration references a class the 2.2.0 core does not have. The fix
      is not to fight the BOM with more pins - it is to let ONE source manage a library's whole
      module set. resilience4j therefore has no version declared anywhere in this build.
    -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>platform-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
